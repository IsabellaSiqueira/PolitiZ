# Copie para .env.local e preencha. Nunca coloque a chave de serviço (service_role) aqui:
# ela só existe nos segredos do GitHub, para a verificação semanal das leis.

# "supabase" liga o app ao banco; sem isso (ou sem as chaves), o app usa os dados simulados
NEXT_PUBLIC_DADOS=simulado

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# só para testes locais sem internet: servidor que imita a API da Câmara
# CAMARA_API_URL=http://127.0.0.1:4010
